{
  "manifest_version": 3,

  "name": "Sentiment Analyzer",

  "version": "1.0",

  "description": "Analyze YouTube comments sentiment",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
   
  ],


  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],

      "js": [
        "content.js"
      ]
    }
  ]
}